load("@bazel_lib//lib:transitions.bzl", "platform_transition_filegroup")
load("@rules_kotlin//kotlin:native.bzl", "kt_native_binary", "kt_native_framework", "kt_native_library", "kt_native_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

package(default_visibility = ["//visibility:public"])

# Build for the host (no flag) or cross-compile with e.g.
#   bazel build //:app --platforms=@rules_kotlin//kotlin/native/platforms:linux_x64

kt_native_library(
    name = "greeter",
    srcs = ["Greeter.kt"],
    module_name = "greeter",
)

kt_native_library(
    name = "app",
    srcs = ["App.kt"],
    module_name = "app",
    deps = [":greeter"],
)

# Multi-source-file library (cross-file references within one module), whose module name, the
# unique_name of its klib, differs from the target name.
kt_native_library(
    name = "util",
    srcs = [
        "Util1.kt",
        "Util2.kt",
    ],
    module_name = "example_util",
)

# 3-level transitive chain: top -> app -> greeter. `top` uses only app's API, but konanc
# must still resolve greeter.klib transitively — exercises the transitive -l closure.
kt_native_library(
    name = "top",
    srcs = ["Top.kt"],
    module_name = "top",
    deps = [":app"],
)

# --- validation: assert each klib is well-formed with the expected manifest ---
# validate_klib.sh <klib> <native target> <unique_name> [depends...]
# These run in the host configuration, so they expect the konan target of the host.

HOST_KONAN_TARGET = select({
    "@rules_kotlin//kotlin/native/platforms:is_linux_x64": ["linux_x64"],
    "@rules_kotlin//kotlin/native/platforms:is_macos_arm64": ["macos_arm64"],
})

sh_test(
    name = "greeter_klib_test",
    srcs = ["validate_klib.sh"],
    args = ["$(rootpath :greeter)"] + HOST_KONAN_TARGET + ["greeter"],
    data = [":greeter"],
)

sh_test(
    name = "app_klib_test",
    srcs = ["validate_klib.sh"],
    args = ["$(rootpath :app)"] + HOST_KONAN_TARGET + [
        "app",
        "greeter",
    ],
    data = [":app"],
)

sh_test(
    name = "top_klib_test",
    srcs = ["validate_klib.sh"],
    args = ["$(rootpath :top)"] + HOST_KONAN_TARGET + [
        "top",
        "app",
    ],
    data = [":top"],
)

sh_test(
    name = "util_klib_test",
    srcs = ["validate_klib.sh"],
    args = ["$(rootpath :util)"] + HOST_KONAN_TARGET + ["example_util"],
    data = [":util"],
)

# --- cross-target: the same klib for every konan target, whatever the host ---
# Every exec host compiles klibs for the Linux targets, but only a macOS one for the Apple
# targets, so those are skipped elsewhere. klibs need no link dependencies, so they build for a
# target whether kotlin_native.targets(...) in MODULE.bazel lists it or not.

# konan target: the constraints the host must meet to compile for it.
CROSS_TARGETS = {
    "ios_arm64": ["@platforms//os:macos"],
    "ios_simulator_arm64": ["@platforms//os:macos"],
    "linux_arm64": [],
    "linux_x64": [],
    "macos_arm64": ["@platforms//os:macos"],
}

[
    platform_transition_filegroup(
        name = "greeter_" + target,
        srcs = [":greeter"],
        target_compatible_with = compatible_with,
        target_platform = "@rules_kotlin//kotlin/native/platforms:" + target,
    )
    for target, compatible_with in CROSS_TARGETS.items()
]

[
    sh_test(
        name = "greeter_%s_klib_test" % target,
        srcs = ["validate_klib.sh"],
        args = [
            "$(rootpath :greeter_%s)" % target,
            target,
            "greeter",
        ],
        data = [":greeter_" + target],
        target_compatible_with = compatible_with,
    )
    for target, compatible_with in CROSS_TARGETS.items()
]

# The transitive chain, for a target other than the host's on every exec host.
platform_transition_filegroup(
    name = "top_linux_arm64",
    srcs = [":top"],
    target_platform = "@rules_kotlin//kotlin/native/platforms:linux_arm64",
)

sh_test(
    name = "top_linux_arm64_klib_test",
    srcs = ["validate_klib.sh"],
    args = [
        "$(rootpath :top_linux_arm64)",
        "linux_arm64",
        "top",
        "app",
    ],
    data = [":top_linux_arm64"],
)

# --- e2e: link a real native executable and actually run it (host target) ---
# `bazel run //:hello` runs it too. The link dependencies come from the link bundle repository of
# the exec host, which stages them for the targets of kotlin_native.targets(...) in MODULE.bazel.

kt_native_binary(
    name = "hello",
    srcs = ["Hello.kt"],
    module_name = "hello",
)

sh_test(
    name = "hello_e2e_test",
    srcs = ["run_hello.sh"],
    args = ["$(rootpath :hello)"],
    data = [":hello"],
)

# --- tests: a test runner of the host target, which bazel test runs ---

# greeter_test tests an internal function of greeter, its associate.
kt_native_test(
    name = "greeter_test",
    srcs = ["GreeterTest.kt"],
    associates = [":greeter"],
)

# FailingTest has a passing and a failing test. failing_test passes, as the test runner's own
# filter in its args leaves the failing one out; failing_test_exit_code_test runs the test runner
# without the filter and expects it to fail.
kt_native_test(
    name = "failing_test",
    srcs = ["FailingTest.kt"],
    args = ["--ktest_filter=*.passes"],
)

sh_test(
    name = "failing_test_exit_code_test",
    srcs = ["expect_test_failure.sh"],
    args = ["$(rootpath :failing_test)"],
    data = [":failing_test"],
)

# --- cross-link: the same executable for each Linux target, a native or a cross link ---

# konan target: the machine of its ELF files.
LINUX_TARGETS = {
    "linux_arm64": "aarch64",
    "linux_x64": "x86_64",
}

[
    platform_transition_filegroup(
        name = "hello_" + target,
        srcs = [":hello"],
        target_platform = "@rules_kotlin//kotlin/native/platforms:" + target,
    )
    for target in LINUX_TARGETS
]

[
    sh_test(
        name = "hello_%s_elf_test" % target,
        srcs = ["check_elf.sh"],
        args = [
            "$(rootpath :hello_%s)" % target,
            machine,
        ],
        data = [":hello_" + target],
    )
    for target, machine in LINUX_TARGETS.items()
]

# --- frameworks: a static Apple framework, linked on a macOS host for each Apple target ---
# GreeterKit exports greeter: its header declares the API of Welcome.kt and of greeter, prefixed
# with the name of the framework.

kt_native_framework(
    name = "GreeterKit",
    srcs = ["Welcome.kt"],
    bundle_id = "org.example.GreeterKit",
    target_compatible_with = select({
        "@platforms//os:ios": [],
        "@platforms//os:macos": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    exports = [":greeter"],
)

# Apple konan target: the platform its frameworks support (CFBundleSupportedPlatforms).
APPLE_TARGETS = {
    "ios_arm64": "iPhoneOS",
    "ios_simulator_arm64": "iPhoneSimulator",
    "macos_arm64": "MacOSX",
}

[
    platform_transition_filegroup(
        name = "GreeterKit_" + target,
        srcs = [":GreeterKit"],
        target_compatible_with = ["@platforms//os:macos"],
        target_platform = "@rules_kotlin//kotlin/native/platforms:" + target,
    )
    for target in APPLE_TARGETS
]

[
    sh_test(
        name = "GreeterKit_%s_framework_test" % target,
        srcs = ["check_framework.sh"],
        args = [
            "$(rootpath :GreeterKit_%s)" % target,
            platform,
            "org.example.GreeterKit",
            "GreeterKitWelcome",
            "GreeterKitGreeter",
        ],
        data = [":GreeterKit_" + target],
        target_compatible_with = ["@platforms//os:macos"],
    )
    for target, platform in APPLE_TARGETS.items()
]

# The files of GreeterKit that rules_apple's apple_static_framework_import imports, the output
# group framework_files: copies of the binary, header, module map and Info.plist of the framework.

filegroup(
    name = "GreeterKit_files",
    srcs = [":GreeterKit"],
    output_group = "framework_files",
)

[
    platform_transition_filegroup(
        name = "GreeterKit_%s_files" % target,
        srcs = [":GreeterKit_files"],
        target_compatible_with = ["@platforms//os:macos"],
        target_platform = "@rules_kotlin//kotlin/native/platforms:" + target,
    )
    for target in APPLE_TARGETS
]

[
    sh_test(
        name = "GreeterKit_%s_files_test" % target,
        srcs = ["check_framework_files.sh"],
        args = [
            "$(rootpath :GreeterKit_%s)" % target,
            "$(rootpaths :GreeterKit_%s_files)" % target,
        ],
        data = [
            ":GreeterKit_" + target,
            ":GreeterKit_%s_files" % target,
        ],
        target_compatible_with = ["@platforms//os:macos"],
    )
    for target in APPLE_TARGETS
]
