common --java_runtime_version=remotejdk_21
common --tool_java_runtime_version=remotejdk_21

# Kotlin/Native actions must not need the network: the distribution and the link dependencies
# come from Bazel repositories, fetched before any action runs.
build --sandbox_default_allow_network=false
test --test_output=errors

# The integration test runner (BazelIntegrationTestRunner) passes every test of the example to
# `bazel coverage` by name, including those a Linux host cannot build, such as the Apple framework
# checks: skip them, as `bazel test //...` does, rather than fail.
build --skip_incompatible_explicit_targets

# Engage path mapping, as examples/path_mapping does: the Kotlin/Native actions declare support for
# it, and take every output path from their params file, so they run with config-free output paths.
# Workers (e.g. the Java compiler building the KonanLauncher) run singleplex and sandboxed: a
# multiplex worker does not resolve the paths of its requests under path mapping.
# Linux and macOS only, the exec hosts of Kotlin/Native (path mapping needs a sandboxing strategy).
common --enable_platform_specific_config
build:linux --experimental_output_paths=strip
build:linux --worker_sandboxing
build:linux --noworker_multiplex
build:macos --experimental_output_paths=strip
build:macos --worker_sandboxing
build:macos --noworker_multiplex
