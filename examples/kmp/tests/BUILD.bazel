load("@bazel_lib//lib:transitions.bzl", "platform_transition_filegroup")
load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@rules_kotlin//kotlin:jvm.bzl", "kt_jvm_test")
load("@rules_kotlin//kotlin:kmp.bzl", "kt_multiplatform_test")
load("@rules_kotlin//kotlin:native.bzl", "kt_native_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

# The aliases of kotlinx.coroutines and kotlinx-coroutines-test, which //shared and the tests call.
COROUTINES = "@kmp_maven//:org_jetbrains_kotlinx_kotlinx_coroutines_core"

COROUTINES_TEST = "@kmp_maven//:org_jetbrains_kotlinx_kotlinx_coroutines_test"

# kotlin.test on the JVM and on Android, with JUnit 4; the Kotlin/Native distribution has its own.
KOTLIN_TEST_JUNIT = [
    "@maven_rules_kotlin_example//:junit_junit",
    "@rules_kotlin//kotlin/compiler:kotlin-test",
    "@rules_kotlin//kotlin/compiler:kotlin-test-junit",
]

# Robolectric for the Android local test, from @robolectric and the rules_android_maven install.
ROBOLECTRIC_DEPS = [
    "@robolectric//bazel:android-all",
    "@rules_android_maven//:org_robolectric_annotations",
    "@rules_android_maven//:org_robolectric_robolectric",
    "@rules_android_maven//:org_robolectric_shadows_framework",
]

# --- every platform: common tests, declared as the sources of //shared are ---
# Gradle's commonTest, intermediate fragments (non_android, native, apple, linux) and platform
# leaves (jvm, android): the common and intermediate tests run on the JVM, as an Android local test
# and on the konan target of the host, with the `actual` helpers of each, as a friend of the library
# of the platform, whose `internal` declarations they call. shared_test runs the tests of the
# platforms the host is compatible with, with no platform flag: shared_test_jvm, shared_test_android
# and shared_test_native.
#
# The local test runs on the JVM of the host, where //shared and the aliases of @kmp_maven select
# their Android variants for it (see @rules_kotlin//kotlin/settings:android): its common test gets
# the platformName() of shared/android, and Robolectric backs the Android framework calls of both
# SharedDiTest (via `expect abstract class RobolectricTest`) and AndroidSharedTest.

kt_multiplatform_test(
    name = "shared_test",
    size = "small",
    srcs = [
        "common/SharedDiTest.kt",
        "common/SharedTest.kt",
    ],
    aliases = {"non_android": [
        "jvm",
        "linux_x64",
        "macos_arm64",
    ]},
    android = dict(
        custom_package = "examples.kmp.tests",
        manifest = "android/AndroidManifest.xml",
        resources = ["fixtures/greeting.txt"],
    ),
    deps_android = KOTLIN_TEST_JUNIT + ROBOLECTRIC_DEPS,
    deps_jvm = KOTLIN_TEST_JUNIT,
    jvm = dict(
        resources = ["fixtures/greeting.txt"],
    ),
    library = "//shared",
    native = dict(
        data = ["fixtures/greeting.txt"],
    ),
    platforms = [
        "jvm",
        "android",
        "linux_x64",
        "macos_arm64",
    ],
    srcs_android = [
        "android/AndroidSharedTest.kt",
        "android/PlatformOfTheTest.android.kt",
    ],
    srcs_apple = ["apple/AppleSharedTest.kt"],
    srcs_jvm = [
        "jvm/JvmSharedTest.kt",
        "jvm/PlatformOfTheTest.jvm.kt",
    ],
    srcs_linux = ["linux/LinuxSharedTest.kt"],
    srcs_native = [
        "native/PlatformOfTheTest.native.kt",
        "native/TestFixture.native.kt",
    ],
    srcs_non_android = ["non_android/NonAndroidSharedTest.kt"],
    deps = [
        COROUTINES,
        COROUTINES_TEST,
    ],
)

# --- subset platforms with runner overrides: jvm.test_class and native --ktest_filter ---

kt_multiplatform_test(
    name = "filtered_test",
    size = "small",
    srcs = ["filtered/FilteredTest.kt"],
    deps_jvm = KOTLIN_TEST_JUNIT,
    jvm = dict(
        test_class = "examples.kmp.tests.SelectedTest",
    ),
    library = "//shared",
    native = dict(
        args = ["--ktest_filter=examples.kmp.tests.SelectedTest.*"],
    ),
    platforms = [
        "jvm",
        "linux_x64",
        "macos_arm64",
    ],
)

# The tests below are of one platform each: a test compiles its own sources only, against the
# library of its platform, which it gets through the alias //shared, as the test compilation of a
# Gradle module compiles against the main one.

# --- JVM: the common code with the JVM actuals, through the alias ---
# The aliases //shared and COROUTINES select a klib for the Kotlin/Native rules only, which set the
# Kotlin platform type to native, so a JVM target gets shared_jvm and the JVM variant of
# kotlinx.coroutines on any host, even one whose konan target the platforms of //shared list.

kt_jvm_test(
    name = "greeting_jvm_test",
    srcs = ["GreetingJvmTest.kt"],
    test_class = "examples.kmp.tests.GreetingJvmTest",
    deps = [
        COROUTINES,
        "//shared",
        "@maven_rules_kotlin_example//:junit_junit",
        "@rules_kotlin//kotlin/compiler:kotlin-test",
    ],
)

# --- native: the common code with the actuals of the host's group, through the alias ---

kt_native_test(
    name = "greeting_native_test",
    srcs = ["GreetingNativeTest.kt"],
    deps = [
        COROUTINES,
        "//shared",
    ],
)

# --- klibs: the native library for every konan target of //shared, whatever the host ---
# Every exec host compiles klibs for the Linux targets, but only a macOS one for the Apple targets,
# so those are skipped elsewhere. Each klib depends on the klib of kotlinx.coroutines of its target.

# konan target: the constraints the host must meet to compile for it.
KONAN_TARGETS = {
    "ios_arm64": ["@platforms//os:macos"],
    "ios_simulator_arm64": ["@platforms//os:macos"],
    "linux_arm64": [],
    "linux_x64": [],
    "macos_arm64": ["@platforms//os:macos"],
}

[
    platform_transition_filegroup(
        name = "shared_native_" + target,
        srcs = ["//shared:shared_native"],
        target_compatible_with = compatible_with,
        target_platform = "@rules_kotlin//kotlin/native/platforms:" + target,
    )
    for target, compatible_with in KONAN_TARGETS.items()
]

[
    sh_test(
        name = "shared_%s_klib_test" % target,
        srcs = ["//:validate_klib.sh"],
        args = [
            "$(rootpath :shared_native_%s)" % target,
            target,
            "shared-shared_native",
            "org.jetbrains.kotlinx:kotlinx-coroutines-core",
        ],
        data = [":shared_native_" + target],
        target_compatible_with = compatible_with,
    )
    for target, compatible_with in KONAN_TARGETS.items()
]

# --- the JVM and Android libraries build ---

build_test(
    name = "shared_libraries_build_test",
    targets = [
        "//shared:shared_android",
        "//shared:shared_jvm",
    ],
)

# --- the derived fragment graphs of //shared and //tests:shared_test ---

sh_test(
    name = "shared_fragments_test",
    size = "small",
    srcs = ["shared_fragments_test.sh"],
    args = ["$(rootpath //shared:shared.fragments)"],
    data = ["//shared:shared.fragments"],
)

sh_test(
    name = "shared_test_fragments_test",
    size = "small",
    srcs = ["shared_test_fragments_test.sh"],
    args = ["$(rootpath :shared_test.fragments)"],
    data = [":shared_test.fragments"],
)
