load("@rules_kotlin//kotlin:core.bzl", "kt_ksp_plugin")
load("@rules_kotlin//kotlin:kmp.bzl", "kt_jvm_ksp_sources", "kt_multiplatform_library", "kt_native_ksp_sources")

# The sources of the module, in the lists of the groups and platforms of the hierarchy they belong
# to: each platform compiles those of its lineage, from the common sources down to its own, and the
# sources that exactly the same platforms compile form one K2 fragment.

# Every platform, through the srcs of the macro: Gradle's commonMain, which declares platformName(),
# PlatformInfo, Clock, injectedGreeting() and injectedNow() with `expect`.
COMMON = [
    "common/Greeting.kt",
    "common/Platform.kt",
    "common/di/Clock.kt",
    "common/di/GreetingRepository.kt",
    "common/di/Injected.kt",
]

# The JVM and the konan targets, not Android: Gradle's nonAndroidMain, an intermediate source set
# outside the hierarchy, which the JVM and native both list.
NON_ANDROID = ["non_android/Greeting.nonAndroid.kt"]

JVM = [
    "jvm/Platform.jvm.kt",
    "jvm/di/Clock.jvm.kt",
    "jvm/di/JvmComponent.kt",
]

ANDROID = [
    "android/Platform.android.kt",
    "android/di/AndroidComponent.kt",
    "android/di/Clock.android.kt",
]

APPLE = [
    "apple/Platform.apple.kt",
    "apple/di/AppleComponent.kt",
    "apple/di/Clock.apple.kt",
]

LINUX = [
    "linux/Injected.linux.kt",
    "linux/Platform.linux.kt",
    "linux/di/Clock.linux.kt",
]

# The deps of the common code, which uses kotlinx.coroutines and the annotations of kotlin-inject:
# every platform gets them from the macro's deps, and their aliases of @kmp_maven (see MODULE.bazel)
# select the variant of the platform, as //shared does. KSP resolves the sources against them too.
COMMON_DEPS = [
    "@kmp_maven//:me_tatarka_inject_kotlin_inject_runtime_kmp",
    "@kmp_maven//:org_jetbrains_kotlinx_kotlinx_coroutines_core",
]

# --- KSP: kotlin-inject components in the sources of the platforms ---
# The `@Component`s are in the platform sources and use the `@Inject` classes of the common ones, so
# KSP runs once per platform, over every source the platform compiles, in a separate action
# (kt_jvm_ksp_sources for the JVM and Android, kt_native_ksp_sources for the konan targets) and
# declares the Kotlin files it generates. A file the processor writes that is not declared, or one
# that is declared but not written, fails the action. KSP takes every source the platform compiles,
# the common ones included, and those also go in the `common_srcs` of the KSP target: KSP processes
# them after the platform's, so the `@Inject expect class Clock` of the common sources resolves to
# the `actual` of the platform, as in the compilation of that platform.
#
# Only the platform or the group that compiles the generated files lists the KSP target in its srcs:
# those of the JVM and Android, in srcs_jvm and srcs_android, are the leaves of their platforms, next
# to JvmComponent and AndroidComponent; those of the Apple targets, in srcs_apple, are in its
# fragment, next to AppleComponent.

kt_ksp_plugin(
    name = "kotlin_inject_ksp",
    processor_class = "me.tatarka.inject.compiler.ksp.InjectProcessorProvider",
    deps = ["@maven_rules_kotlin_example//:me_tatarka_inject_kotlin_inject_compiler_ksp"],
)

kt_jvm_ksp_sources(
    name = "shared_ksp_jvm",
    srcs = COMMON + NON_ANDROID + JVM,
    common_srcs = COMMON,
    generated = ["examples/kmp/shared/di/InjectJvmComponent.kt"],
    processors = [":kotlin_inject_ksp"],
    deps = COMMON_DEPS,
)

kt_jvm_ksp_sources(
    name = "shared_ksp_android",
    srcs = COMMON + ANDROID,
    android = True,
    common_srcs = COMMON,
    generated = ["examples/kmp/shared/di/InjectAndroidComponent.kt"],
    processors = [":kotlin_inject_ksp"],
    deps = COMMON_DEPS,
)

kt_native_ksp_sources(
    name = "shared_ksp_apple",
    srcs = COMMON + NON_ANDROID + APPLE,
    common_srcs = COMMON,
    generated = ["examples/kmp/shared/di/InjectAppleComponent.kt"],
    processors = [":kotlin_inject_ksp"],
    deps = COMMON_DEPS,
)

# The fragments the macro derives, one per group with sources and one of the sources the JVM and
# native share, each refining the fragments above it in the hierarchy:
#   COMMON       common, the srcs of the macro
#   NON_ANDROID  jvm-native, which the JVM and native both list, refines common
#   APPLE        apple, refines jvm-native
#   LINUX        linux, refines jvm-native
# JVM and ANDROID are the leaves `jvm` and `android`, with their KSP outputs; the leaves of the konan
# targets are empty. The `actual` declarations are in the leaves of the JVM and Android and in the
# fragments of the Apple and Linux sources, so every platform compiles one `actual` per `expect`.
#
# The macro declares a private target per fragment (shared_fragment_<fragment>), shared_jvm,
# shared_android, shared_native, shared_srcs, shared.fragments and the alias shared, which selects
# the library of its consumer: shared_native for a Kotlin/Native rule, shared_android for an Android
# platform, shared_jvm otherwise. Every platform compiles the srcs and deps of the macro, then the
# srcs of the groups above it and its own.
kt_multiplatform_library(
    name = "shared",
    srcs = COMMON,
    android = dict(
        custom_package = "examples.kmp.shared",
        manifest = "android/AndroidManifest.xml",
    ),
    platforms = [
        "jvm",
        "android",
        "ios_arm64",
        "ios_simulator_arm64",
        "macos_arm64",
        "linux_arm64",
        "linux_x64",
    ],
    srcs_android = ANDROID + [":shared_ksp_android"],
    srcs_apple = APPLE + [":shared_ksp_apple"],
    srcs_jvm = NON_ANDROID + JVM + [":shared_ksp_jvm"],
    srcs_linux = LINUX,
    srcs_native = NON_ANDROID,
    visibility = ["//visibility:public"],
    deps = COMMON_DEPS,
)
