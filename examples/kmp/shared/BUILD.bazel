load("@rules_kotlin//kotlin:core.bzl", "kt_ksp_plugin")
load("@rules_kotlin//kotlin:kmp.bzl", "kt_jvm_ksp_sources", "kt_multiplatform_library", "kt_native_ksp_sources")

# Every platform, through the srcs of the macro: Gradle's commonMain, which declares platformName(),
# PlatformInfo, Clock, injectedGreeting() and injectedNow() with `expect`.
COMMON = [
    "common/Greeting.kt",
    "common/Platform.kt",
    "common/di/Clock.kt",
    "common/di/GreetingRepository.kt",
    "common/di/Injected.kt",
]

# The JVM and the konan targets, not Android: Gradle's nonAndroidMain, an intermediate source set
# outside the hierarchy, which the alias `non_android` of the macro names.
NON_ANDROID = ["non_android/Greeting.nonAndroid.kt"]

JVM = [
    "jvm/Platform.jvm.kt",
    "jvm/di/Clock.jvm.kt",
    "jvm/di/JvmComponent.kt",
]

ANDROID = [
    "android/Platform.android.kt",
    "android/di/AndroidComponent.kt",
    "android/di/Clock.android.kt",
]

APPLE = [
    "apple/Platform.apple.kt",
    "apple/di/AppleComponent.kt",
    "apple/di/Clock.apple.kt",
]

LINUX = [
    "linux/Injected.linux.kt",
    "linux/Platform.linux.kt",
    "linux/di/Clock.linux.kt",
]

# The deps of the common code, which uses kotlinx.coroutines and the annotations of kotlin-inject:
# every platform gets them from the macro's deps, and their aliases of @kmp_maven (see MODULE.bazel)
# select the variant of the platform, as //shared does. KSP resolves the sources against them too.
COMMON_DEPS = [
    "@kmp_maven//:me_tatarka_inject_kotlin_inject_runtime_kmp",
    "@kmp_maven//:org_jetbrains_kotlinx_kotlinx_coroutines_core",
]

# --- KSP: kotlin-inject components in the sources of the platforms ---
# KSP runs once per platform, in a separate action that declares the Kotlin files it generates (see
# docs/kmp.md). It takes every source the platform compiles, the common ones also as `common_srcs`,
# so the `@Inject expect class Clock` of the common sources resolves to the `actual` of the platform.
# Only the platform or the group that compiles the generated files lists the KSP target in its srcs.

kt_ksp_plugin(
    name = "kotlin_inject_ksp",
    processor_class = "me.tatarka.inject.compiler.ksp.InjectProcessorProvider",
    deps = ["@maven_rules_kotlin_example//:me_tatarka_inject_kotlin_inject_compiler_ksp"],
)

kt_jvm_ksp_sources(
    name = "shared_ksp_jvm",
    srcs = COMMON + NON_ANDROID + JVM,
    common_srcs = COMMON,
    generated = ["examples/kmp/shared/di/InjectJvmComponent.kt"],
    processors = [":kotlin_inject_ksp"],
    deps = COMMON_DEPS,
)

kt_jvm_ksp_sources(
    name = "shared_ksp_android",
    srcs = COMMON + ANDROID,
    android = True,
    common_srcs = COMMON,
    generated = ["examples/kmp/shared/di/InjectAndroidComponent.kt"],
    processors = [":kotlin_inject_ksp"],
    deps = COMMON_DEPS,
)

kt_native_ksp_sources(
    name = "shared_ksp_apple",
    srcs = COMMON + NON_ANDROID + APPLE,
    common_srcs = COMMON,
    generated = ["examples/kmp/shared/di/InjectAppleComponent.kt"],
    processors = [":kotlin_inject_ksp"],
    deps = COMMON_DEPS,
)

# The fragments the macro derives, one per group and alias with sources, each refining the
# fragments of the groups and aliases whose platforms include its own:
#   COMMON       common, the srcs of the macro
#   NON_ANDROID  non_android, the alias of every platform but Android, refines common
#   APPLE        apple, refines non_android
#   LINUX        linux, refines non_android
# JVM and ANDROID are the leaves `jvm` and `android`, with their KSP outputs; the leaves of the konan
# targets are empty. The `actual` declarations are in the leaves of the JVM and Android and in the
# fragments of the Apple and Linux sources, so every platform compiles one `actual` per `expect`.
kt_multiplatform_library(
    name = "shared",
    srcs = COMMON,
    aliases = {"non_android": [
        "jvm",
        "ios_arm64",
        "ios_simulator_arm64",
        "macos_arm64",
        "linux_arm64",
        "linux_x64",
    ]},
    android = dict(
        custom_package = "examples.kmp.shared",
        manifest = "android/AndroidManifest.xml",
    ),
    platforms = [
        "jvm",
        "android",
        "ios_arm64",
        "ios_simulator_arm64",
        "macos_arm64",
        "linux_arm64",
        "linux_x64",
    ],
    srcs_android = ANDROID + [":shared_ksp_android"],
    srcs_apple = APPLE + [":shared_ksp_apple"],
    srcs_jvm = JVM + [":shared_ksp_jvm"],
    srcs_linux = LINUX,
    srcs_non_android = NON_ANDROID,
    visibility = ["//visibility:public"],
    deps = COMMON_DEPS,
)
