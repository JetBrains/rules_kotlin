load("@rules_apple//apple:ios.bzl", "ios_unit_test")
load("@rules_kotlin//kotlin:kmp.bzl", "kt_multiplatform_library", "kt_multiplatform_test")

# The alias of kotlinx.coroutines (see MODULE.bazel), which selects its variant like //shared does.
COROUTINES = "@kmp_maven//:org_jetbrains_kotlinx_kotlinx_coroutines_core"

# The common code of src/commonMain, which every platform compiles with its own sources.
COMMON = glob(["src/commonMain/kotlin/**/*.kt"])

# The shared module of the wizard's project, whose Gradle build declares the androidTarget, iosArm64,
# iosSimulatorArm64 and jvm targets, the platforms of the macro. The sources of src/commonMain are
# its srcs, and those of src/<group or platform>Main the srcs of that group or platform. The alias
# shared selects the library of its consumer: shared_native for the framework of //iosApp,
# shared_android for the deps of //androidApp, and shared_jvm otherwise.
kt_multiplatform_library(
    name = "shared",
    srcs = COMMON,
    android = dict(
        custom_package = "org.example.kmpapp",
        manifest = "src/androidMain/AndroidManifest.xml",
    ),
    platforms = [
        "jvm",
        "android",
        "ios_arm64",
        "ios_simulator_arm64",
    ],
    srcs_android = glob(["src/androidMain/kotlin/**/*.kt"]),
    srcs_ios = glob(["src/iosMain/kotlin/**/*.kt"]),
    srcs_jvm = glob(["src/jvmMain/kotlin/**/*.kt"]),
    visibility = ["//visibility:public"],
    deps = [COROUTINES],
)

# The tests of src/commonTest and the per-platform test source sets (jvmTest, androidUnitTest,
# iosTest), Gradle's allTests: every platform compiles commonTest with its own test sources against
# its library of //shared and the variant of kotlinx.coroutines the alias selects for it.
# shared_test runs, with no platform flag:
#   shared_test_jvm      on the JVM of the host;
#   shared_test_android  as a local test, on the JVM of the host, with the Android `actual`;
#   shared_test_ios      in the iOS simulator, in the test bundle of ios_unit_test, on an arm64 Mac:
#                        elsewhere it is skipped, as incompatible.
# The device target ios_arm64 of //shared is not listed: its tests would need a signed bundle.

# kotlin.test on the JVM and on Android, with JUnit 4; the Kotlin/Native distribution has its own.
KOTLIN_TEST_JUNIT = [
    "@maven_rules_kotlin_example//:junit_junit",
    "@rules_kotlin//kotlin/compiler:kotlin-test",
    "@rules_kotlin//kotlin/compiler:kotlin-test-junit",
]

kt_multiplatform_test(
    name = "shared_test",
    srcs = glob(["src/commonTest/kotlin/**/*.kt"]),
    deps_android = KOTLIN_TEST_JUNIT,
    deps_jvm = KOTLIN_TEST_JUNIT,
    env = {"KMP_APP_TEST_ENV": "kmp_app_shared_env"},
    ios = dict(
        minimum_os_version = "15.0",
        resources = ["src/iosTest/resources/ios_fixture.txt"],
    ),
    ios_test_rule = ios_unit_test,
    jvm = dict(
        resources = ["src/jvmTest/resources/jvm_fixture.txt"],
    ),
    library = ":shared",
    platforms = [
        "jvm",
        "android",
        "ios_simulator_arm64",
    ],
    srcs_android = glob(["src/androidUnitTest/kotlin/**/*.kt"]),
    srcs_ios = glob(["src/iosTest/kotlin/**/*.kt"]),
    srcs_jvm = glob(["src/jvmTest/kotlin/**/*.kt"]),
    deps = [COROUTINES],
)
