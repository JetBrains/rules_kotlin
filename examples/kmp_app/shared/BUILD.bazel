load("@rules_kotlin//kotlin:jvm.bzl", "kt_jvm_test")
load("@rules_kotlin//kotlin:kmp.bzl", "kt_multiplatform_library")

# The alias of kotlinx.coroutines (see MODULE.bazel), which selects its variant like //shared does.
COROUTINES = "@kmp_maven//:org_jetbrains_kotlinx_kotlinx_coroutines_core"

# The shared module of the wizard's project, whose Gradle build declares the androidTarget, iosArm64,
# iosSimulatorArm64 and jvm targets. Each platform compiles the common code with its own `actual`
# getPlatform(), as K2 fragments. The macro declares shared_common, shared_android, shared_jvm,
# shared_ios, shared_native and the alias shared, which selects the library of its consumer:
# shared_native for a Kotlin/Native rule, such as the framework of //iosApp; shared_android for an
# Android platform, such as the deps of //androidApp; shared_jvm otherwise, such as GreetingTest.
kt_multiplatform_library(
    name = "shared",
    android = dict(
        srcs = glob(["src/androidMain/kotlin/**/*.kt"]),
        custom_package = "org.example.kmpapp",
        manifest = "src/androidMain/AndroidManifest.xml",
    ),
    common_deps = [COROUTINES],
    common_srcs = glob(["src/commonMain/kotlin/**/*.kt"]),
    jvm = dict(srcs = glob(["src/jvmMain/kotlin/**/*.kt"])),
    native = {
        "ios": dict(
            srcs = glob(["src/iosMain/kotlin/**/*.kt"]),
            targets = [
                "ios_arm64",
                "ios_simulator_arm64",
            ],
        ),
    },
    visibility = ["//visibility:public"],
)

# The common tests, on the JVM of the host: the JVM variant of the common code and of
# kotlinx.coroutines, on any host.
kt_jvm_test(
    name = "GreetingTest",
    srcs = glob(["src/commonTest/kotlin/**/*.kt"]),
    test_class = "org.example.kmpapp.GreetingTest",
    deps = [
        COROUTINES,
        ":shared",
        "@maven_rules_kotlin_example//:junit_junit",
        "@rules_kotlin//kotlin/compiler:kotlin-test",
        "@rules_kotlin//kotlin/compiler:kotlin-test-junit",
    ],
)
