common --java_runtime_version=remotejdk_21
common --tool_java_runtime_version=remotejdk_21

# The Android build tools use Java 17 language features, and abseil-cpp, which they build, C++17
# (as in examples/android).
common --tool_java_language_version=17
common --repo_env=ACCEPTED_ANDROID_SDK_LICENSE_VERSION=35
common --repo_env=ACCEPTED_ANDROID_NDK_LICENSE_VERSION=r29
build --cxxopt=-std=c++17
build --host_cxxopt=-std=c++17

# The actions must not need the network: the compilers, the Android SDK and the Kotlin/Native
# distribution come from Bazel repositories, fetched before any action runs.
build --sandbox_default_allow_network=false
test --test_output=errors

# The integration test runner passes every test of the example to `bazel coverage` by name: skip
# those the host cannot build, as `bazel test //...` does, rather than fail.
build --skip_incompatible_explicit_targets

# android_binary builds its deps for this platform, so //shared and the aliases of @kmp_maven
# select their Android variants, as the androidApp module of a Gradle build does. The label is
# canonical: on Bazel 9, rules_android aliases the flag to its own and reads its labels there.
build --android_platforms=@@//:android_arm64

# ios_application builds its deps for the iOS simulator of an arm64 Mac, which needs no signing:
# the framework of //shared is then linked for ios_simulator_arm64. --ios_multi_cpus=arm64 builds
# for a device, which needs a provisioning profile.
build --ios_multi_cpus=sim_arm64

# bazel coverage instruments the Kotlin code of //shared and //androidApp. The Swift code of the iOS
# app is left out: ios_application does not link the profile runtime that instrumented Swift needs.
coverage --instrumentation_filter=^//shared[/:],^//androidApp[/:]

# iOS needs Xcode: a Linux host builds the Android app and the JVM test only.
common --enable_platform_specific_config
common:linux --deleted_packages=iosApp
