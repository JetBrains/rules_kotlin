load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("//src/main/starlark/release:packager.bzl", "release_archive")

release_archive(
    name = "pkg",
    srcs = glob([
        "*.bzl",
        "*.sh",
    ]),
    src_map = {
        "BUILD.release.bazel": "BUILD.bazel",
    },
)

# The fragments of a kt_multiplatform_library, which the JVM and Kotlin/Native rules load.
bzl_library(
    name = "kmp",
    srcs = [
        "derive.bzl",
        "fragment.bzl",
        "fragments.bzl",
    ],
    visibility = ["//kotlin:__subpackages__"],
)

# The macro and the KSP rules, apart: they load the JVM, Android and Kotlin/Native rules, which
# load the fragments.
bzl_library(
    name = "multiplatform",
    srcs = [
        "ksp.bzl",
        "multiplatform.bzl",
    ],
    visibility = ["//kotlin:__subpackages__"],
    deps = [
        ":kmp",
        "//kotlin/internal/jvm",
        "//kotlin/internal/native",
    ],
)

# The script of the KSP action (ksp.bzl).
sh_binary(
    name = "ksp_run",
    srcs = ["ksp_run.sh"],
    visibility = ["//visibility:public"],
)

exports_files(
    glob([
        "*.bzl",
        "*.sh",
    ]),
    visibility = ["//visibility:public"],
)
