load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("//kotlin/internal/native:toolchains.bzl", "define_kt_native_toolchains")
load("//src/main/starlark/release:packager.bzl", "release_archive")

release_archive(
    name = "pkg",
    srcs = glob(["*.bzl"]) + [
        "TestLauncher.kt",
        "XCTestLauncher.kt",
        "XCTestShim.m",
    ],
    src_map = {
        "BUILD.release.bazel": "BUILD.bazel",
    },
)

bzl_library(
    name = "native",
    srcs = glob(["*.bzl"]),
    visibility = [
        "//kotlin:__subpackages__",
        "//src/main/starlark/core/repositories:__pkg__",
    ],
    deps = [
        "//kotlin/internal/kmp",
        "//kotlin/internal/utils",
        "//src/main/starlark/core/plugin",
        "@bazel_skylib//lib:dicts",
        "@bazel_skylib//rules/directory:providers",
        "@build_bazel_apple_support//lib:apple_support",
        "@build_bazel_apple_support//xcode:providers",
        "@rules_cc//cc:action_names_bzl",
        "@rules_cc//cc:find_cc_toolchain_bzl",
        "@rules_cc//cc/common",
    ],
)

toolchain_type(
    name = "kt_native_toolchain_type",
    visibility = ["//visibility:public"],
)

exports_files(
    glob(["*.bzl"]) + [
        "TestLauncher.kt",
        "XCTestLauncher.kt",
        "XCTestShim.m",
    ],
    visibility = ["//visibility:public"],
)

# A toolchain per (exec host, konan target) of EXEC_HOSTS (see define_kt_native_toolchains).
define_kt_native_toolchains()
