load("//src/main/starlark/release:packager.bzl", "release_archive")

release_archive(
    name = "pkg",
    src_map = {
        "BUILD.release.bazel": "BUILD.bazel",
    },
)

# Flag that controls the emission of jdeps files during kotlin jvm compilation.
bool_flag(
    name = "jvm_emit_jdeps",
    build_setting_default = True,  # Upstream default behavior
    visibility = ["//visibility:public"],
)

# --@rules_kotlin//kotlin/settings:experimental_prune_transitive_deps=True
bool_flag(
    name = "experimental_prune_transitive_deps",
    build_setting_default = False,
    visibility = ["//visibility:public"],
)

# Comma-separated canonical repository names whose transitive compile jars should
# remain on the classpath when experimental_prune_transitive_deps is enabled.
# --@rules_kotlin//kotlin/settings:experimental_prune_transitive_deps_keep_transitive_repositories=repo_a,repo_b
string_list_flag(
    name = "experimental_prune_transitive_deps_keep_transitive_repositories",
    build_setting_default = [],
    visibility = ["//visibility:public"],
)

# --@rules_kotlin//kotlin/settings:experimental_strict_associate_dependencies=True
bool_flag(
    name = "experimental_strict_associate_dependencies",
    build_setting_default = False,
    visibility = ["//visibility:public"],
)

bool_flag(
    name = "experimental_build_tools_api",
    build_setting_default = False,
    visibility = ["//visibility:public"],
)

# True when the build setting above turns the Build Tools API compilation on.
config_setting(
    name = "experimental_build_tools_api_enabled",
    flag_values = {":experimental_build_tools_api": "True"},
    visibility = ["//visibility:public"],
)

# --@rules_kotlin//kotlin/settings:experimental_ksp2_psi_resolution=True
# Enables KSP2's experimental PSI-based symbol resolution strategy.
bool_flag(
    name = "experimental_ksp2_psi_resolution",
    build_setting_default = False,
    visibility = ["//visibility:public"],
)

# --@rules_kotlin//kotlin/settings:experimental_native_header_klibs=True
# A kt_native_library also writes a header klib, its declarations without function bodies, which
# the Kotlin/Native compilations of its dependents read instead of its klib. Links read full klibs.
# The tag kt_native_header_klib_incompatible turns it off for one library.
bool_flag(
    name = "experimental_native_header_klibs",
    build_setting_default = False,
    visibility = ["//visibility:public"],
)

# --@rules_kotlin//kotlin/settings:experimental_native_build_tools_api=False
# Kotlin/Native klib compilations run a NativeKlibCompilationOperation of the Kotlin Build Tools API
# in-process, instead of the konanc command line. A Kotlin/Native release without a Build Tools API
# runtime (older than 2.5.20-dev-4986, or unpinned without kotlin_native.version(btapi_sha256 = ...))
# always compiles klibs with the command line, and so does every link, cinterop and klib action.
bool_flag(
    name = "experimental_native_build_tools_api",
    build_setting_default = True,
    visibility = ["//visibility:public"],
)

# The Kotlin platform a target is built for, the Bazel form of the Gradle attribute
# org.jetbrains.kotlin.platform.type: jvm (the JVM and Android rules) or native. The Kotlin/Native
# rules set it to native for themselves and their deps with a rule transition, so it needs no setting
# on the command line. A select() tells a Kotlin/Native consumer from a JVM one with the
# config_settings @rules_kotlin//kotlin/native/platforms:native and native_<konan target>.
# The scope is target: the exec transition resets it, as the tools of a Kotlin/Native target, e.g.
# its compiler plugins, are JVM code. Bazel 7 and 8 ignore the scope: see kt_jvm_tool_transition.
string_flag(
    name = "kotlin_platform_type",
    build_setting_default = "jvm",
    scope = "target",
    values = [
        "jvm",
        "native",
    ],
    visibility = ["//visibility:public"],
)
