"""Module extension kmp_maven: the Maven dependencies of Kotlin Multiplatform code, from a manifest pinned with bazel-kmp-resolver.

kmp_maven.install declares Maven coordinates as the commonMain source set of a Kotlin Gradle build
does, e.g. `org.jetbrains.kotlinx:kotlinx-coroutines-core:1.10.2`, and the platforms to resolve
them for. `bazel run @<name>//pin` resolves them with bazel-kmp-resolver into a manifest committed
in the workspace; from that manifest, the extension creates:
- `<name>`, the hub: per library, a kt_klib_import per klib and konan target, a kt_jvm_import or
  aar_import per Android and JVM variant, and the alias `@<name>//:<group>_<artifact>` (letters
  and digits, the rest replaced by `_`), which selects the klib for the Kotlin/Native rules, the
  Android variant on Android and the JVM variant otherwise;
- a repository per Maven module, which downloads its files by URL and integrity when a build
  needs them, so a build only downloads the artifacts of the platforms it builds for;
- `bazel_kmp_resolver`, the binary of the resolver, which only the pin target fetches: the release
  asset of the host, of the release rules_kotlin pins or of kmp_maven.resolver, checked against its
  sha256.

While the manifest is missing or stale for the inputs of the install, any target of the hub fails
with the command pinning it, which works. See docs/kmp_dependencies.md.
"""

load("@bazel_tools//tools/build_defs/repo:utils.bzl", "get_auth")
load(
    ":kmp_maven_impl.bzl",
    "KMP_DEFAULT_REPOSITORIES",
    "KMP_PLATFORMS",
    "KMP_RESOLVER_LABEL",
    "KMP_RESOLVER_REPOSITORY",
    "collect_kmp_maven_config",
    "decode_manifest",
    "hub_build_file",
    "manifest_problem",
    "module_build_file",
    "module_repositories",
    "pin_build_file",
    "pin_script",
    "resolver_download",
    "unpinned_build_file",
)

def _reproducible(repository_ctx):
    # Bazel <8.3.0 lacks repository_ctx.repo_metadata
    if not hasattr(repository_ctx, "repo_metadata"):
        return None
    return repository_ctx.repo_metadata(reproducible = True)

def _kmp_maven_module_repository_impl(repository_ctx):
    files = repository_ctx.attr.files
    for file_name, download in files.items():
        urls = download[1:]
        repository_ctx.download(
            urls,
            output = file_name,
            integrity = download[0],
            auth = get_auth(repository_ctx, urls),
        )
    repository_ctx.file("BUILD.bazel", module_build_file(files.keys()), executable = False)
    return _reproducible(repository_ctx)

kmp_maven_module_repository = repository_rule(
    doc = "The files of a Maven module of a kmp_maven manifest, downloaded by URL and integrity.",
    implementation = _kmp_maven_module_repository_impl,
    attrs = {
        "files": attr.string_list_dict(
            doc = "the files to download, as file name -> [integrity, url, ...]",
            mandatory = True,
        ),
    },
)

def _kmp_maven_hub_repository_impl(repository_ctx):
    attr = repository_ctx.attr
    repository_ctx.file("BUILD.bazel", attr.build_file, executable = False)
    repository_ctx.file("pin/BUILD.bazel", attr.pin_build_file, executable = False)
    repository_ctx.file("pin/pin.sh", attr.pin_script, executable = True)
    return _reproducible(repository_ctx)

kmp_maven_hub_repository = repository_rule(
    doc = "The hub of a kmp_maven.install: the imports and aliases of its libraries, and its pin target.",
    implementation = _kmp_maven_hub_repository_impl,
    attrs = {
        "build_file": attr.string(doc = "the content of the BUILD file of the root package", mandatory = True),
        "pin_build_file": attr.string(doc = "the content of the BUILD file of the pin package", mandatory = True),
        "pin_script": attr.string(doc = "the content of pin/pin.sh", mandatory = True),
    },
)

_RESOLVER_BUILD = """\
# The bazel-kmp-resolver binary of the pin targets of kmp_maven. Generated by rules_kotlin.
filegroup(
    name = "bazel-kmp-resolver",
    srcs = ["bin/{executable}"],
    visibility = ["//visibility:public"],
)
"""

def _kmp_resolver_repository_impl(repository_ctx):
    attr = repository_ctx.attr
    download = resolver_download(
        repository_ctx.os.name,
        repository_ctx.os.arch,
        struct(version = attr.version, sha256 = attr.sha256),
    )
    if download.error:
        fail(download.error)
    repository_ctx.download(
        download.url,
        output = "bin/" + download.executable,
        sha256 = download.sha256,
        executable = True,
        auth = get_auth(repository_ctx, [download.url]),
    )
    repository_ctx.file("BUILD.bazel", _RESOLVER_BUILD.format(executable = download.executable), executable = False)
    return _reproducible(repository_ctx)

kmp_resolver_repository = repository_rule(
    doc = "The bazel-kmp-resolver binary of the pin targets: the release asset of the host, checked against its sha256.",
    implementation = _kmp_resolver_repository_impl,
    attrs = {
        "sha256": attr.string_dict(doc = "the sha256 of the release asset of each host"),
        "version": attr.string(doc = "the release of bazel-kmp-resolver", mandatory = True),
    },
)

def _read_manifest(module_ctx, manifest):
    """The content of the manifest of an install, "" when it is missing; watched, so pinning it re-runs the extension."""
    path = module_ctx.path(manifest)
    if not path.exists:
        module_ctx.watch(path)
        return ""
    return module_ctx.read(manifest)

def _kmp_maven_impl(module_ctx):
    config = collect_kmp_maven_config(module_ctx.modules)
    for install in config.installs:
        manifest = decode_manifest(_read_manifest(module_ctx, install.manifest))
        problem = manifest_problem(install.name, install.manifest_path, manifest, install.inputs)
        if problem:
            build_file = unpinned_build_file(install.name, problem)
        else:
            build_file = hub_build_file(install.name, install.manifest_path, manifest, install.fetch_sources, install.extra_dependencies)
            for name, files in module_repositories(install.name, manifest, install.fetch_sources).items():
                kmp_maven_module_repository(
                    name = name,
                    files = {file_name: [download.integrity] + download.urls for file_name, download in files.items()},
                )
        kmp_maven_hub_repository(
            name = install.name,
            build_file = build_file,
            pin_build_file = pin_build_file(install.name, KMP_RESOLVER_LABEL),
            pin_script = pin_script(install.name, install.manifest_path, install.inputs),
        )
    kmp_resolver_repository(
        name = KMP_RESOLVER_REPOSITORY,
        version = config.resolver.version,
        sha256 = config.resolver.sha256,
    )
    return module_ctx.extension_metadata(reproducible = True)

_install_tag = tag_class(
    doc = """Maven libraries of Kotlin Multiplatform code, resolved for platforms into a manifest pinned in the workspace.

    Only the root module may declare installs, each with its own name: the hub repository to
    `use_repo`. Run `bazel run @<name>//pin` to write the manifest after adding the tag or changing
    its artifacts, repositories, platforms or substitutions, and commit it.""",
    attrs = {
        "artifacts": attr.string_list(
            doc = "The Maven coordinates, `group:artifact:version`, e.g. `org.jetbrains.kotlinx:kotlinx-coroutines-core:1.10.2`.",
            mandatory = True,
        ),
        "extra_dependencies": attr.string_list_dict(
            doc = "Dependencies the published metadata of a library omits, `{\"group:artifact\": [\"group:artifact\", ...]}`, " +
                  "e.g. the Compose libraries a library compiled against without declaring them. Each is a dep of every " +
                  "variant of the library, for its platform, as the dependencies of the metadata are, and must be a " +
                  "library of the manifest: an artifact of the install or a dependency of one. The dexing of an " +
                  "android_binary desugars each library against its own dependencies, and fails on a type they lack.",
        ),
        "fetch_sources": attr.bool(
            doc = "Whether to download the sources jars, as the srcjar of the JVM and Android imports.",
        ),
        "manifest": attr.label(
            doc = "The manifest, a file of a package of the root module, e.g. `//:kmp_manifest.json`. The pin target writes it.",
            mandatory = True,
        ),
        "name": attr.string(
            doc = "The name of the hub repository, e.g. `kmp_maven`.",
            mandatory = True,
        ),
        "platforms": attr.string_list(
            doc = "The platforms to resolve the artifacts for: `jvm`, `android` and the konan targets of " +
                  "`@rules_kotlin//kotlin/native/platforms`; all of them by default.",
            default = KMP_PLATFORMS,
        ),
        "repositories": attr.string_list(
            doc = "The Maven repositories, in the order the artifacts are looked up in.",
            default = KMP_DEFAULT_REPOSITORIES,
        ),
        "substitutions": attr.string_list(
            doc = "Versions forced in the resolution, `group:artifact=group:artifact:version`, e.g. to align " +
                  "`org.jetbrains.kotlin:kotlin-stdlib` with the Kotlin toolchain.",
        ),
    },
)

_resolver_tag = tag_class(
    doc = """The release of bazel-kmp-resolver the pin targets download, instead of the one rules_kotlin pins.

    Only the root module may declare it. Its checksums override those rules_kotlin pins for the same
    version; on a host without checksum, the pin target fails with the asset to add.""",
    attrs = {
        "sha256": attr.string_dict(
            doc = "The sha256 of the release asset per host: linux-arm64, linux-x64, macos-arm64, macos-x64, windows-x64.",
        ),
        "version": attr.string(
            doc = "The release, e.g. 0.4.0.",
            mandatory = True,
        ),
    },
)

kmp_maven = module_extension(
    doc = "The Maven dependencies of Kotlin Multiplatform code: see kmp_maven.install.",
    implementation = _kmp_maven_impl,
    tag_classes = {
        "install": _install_tag,
        "resolver": _resolver_tag,
    },
)
