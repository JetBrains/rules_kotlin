load("@com_github_jetbrains_kotlin//:version.bzl", "KOTLINC_VERSION")
load("@rules_java//java:java_binary.bzl", "java_binary")
load("@rules_java//java:java_import.bzl", "java_import")
load("//kotlin/compiler:compiler.bzl", _KOTLIN_STDLIBS = "KOTLIN_STDLIBS")
load("//src/main/starlark/core/compile:common.bzl", "TYPE")
load(":toolchain.bzl", "cli_toolchain")

java_import(
    name = "kotlinc_jar",
    jars = [
        "@com_github_jetbrains_kotlin//:kotlin-compiler",
    ],
    deps = [],
)

java_binary(
    name = "kotlinc",
    data = _KOTLIN_STDLIBS,
    main_class = "org.jetbrains.kotlin.cli.jvm.K2JVMCompiler",
    runtime_deps = [":kotlinc_jar"],
)

# The language level of the compiler release, which a kotlinc_version override may change.
cli_toolchain(
    name = "cli_toolchain",
    api_version = KOTLINC_VERSION,
    jvm_target = "11",
    kotlin_stdlibs = _KOTLIN_STDLIBS,
    kotlinc = ":kotlinc",
    language_version = KOTLINC_VERSION,
    zip = "@bazel_tools//tools/zip:zipper",
)

toolchain(
    name = "cli",
    toolchain = ":cli_toolchain",
    toolchain_type = TYPE,
)
