# Analyses the Android local test of a kt_multiplatform_test for coverage on Bazel 8, which
# registers the baseline coverage action of a target in every call of instrumented_files_info: a
# newer Bazel does not show two calls that disagree.
bazel_integration_test(
    name = "android_local_test_coverage_test",
    timeout = "eternal",
    additional_env_inherit = [
        # allows persistent shared repository cache for bazel-under-test artifacts
        "RULES_KOTLIN_REPOSITORY_CACHE",
    ],
    bazel_binaries = bazel_binaries,
    bazel_version = "8.x",
    data = ["//:rules_kotlin_release"],
    env = {
        "RULES_KOTLIN_RELEASE": "$(rlocationpath //:rules_kotlin_release)",
    },
    tags = [
        "no-remote",
        "requires-network",
    ],
    test_runner = ":android_local_test_coverage_test_runner",
)
