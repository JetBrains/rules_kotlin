"""Bazel module manifest for the released rules_kotlin package."""

module(
    name = "rules_kotlin",
    version = "1.9.0",
    compatibility_level = 1,
    repo_name = "rules_kotlin",
)

bazel_dep(name = "platforms", version = "0.0.11")
bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "rules_java", version = "8.9.0")
bazel_dep(name = "rules_license", version = "1.0.0")
bazel_dep(name = "rules_android", version = "0.8.1")
bazel_dep(name = "bazel_features", version = "1.39.0")
bazel_dep(name = "bazel_lib", version = "3.1.0")

rules_java_toolchains = use_extension("@rules_java//java:extensions.bzl", "toolchains")
use_repo(rules_java_toolchains, "remote_java_tools")

rules_kotlin_extensions = use_extension(
    "//src/main/starlark/core/repositories:bzlmod_setup.bzl",
    "rules_kotlin_extensions",
)
use_repo(
    rules_kotlin_extensions,
    "btapi_impl",
    "com_github_google_ksp",
    "com_github_jetbrains_kotlin",
    "com_github_pinterest_ktlint",
    "jarjar",
    "kotlin_build_tools_api",
    "kotlinx_coroutines_core_jvm",
    "kotlinx_serialization_core_jvm",
    "kotlinx_serialization_json",
    "kotlinx_serialization_json_jvm",
)

register_toolchains("//kotlin:default_toolchain")

# Kotlin/Native (experimental). Repos are fetched lazily, only when a native target is built.
bazel_dep(name = "rules_shell", version = "0.4.1")

# The Apple platforms in //kotlin/native/platforms use apple_support's constraints.
bazel_dep(name = "apple_support", version = "2.5.2", repo_name = "build_bazel_apple_support")

kotlin_native = use_extension("//src/main/starlark/core/repositories:native.bzl", "kotlin_native")
use_repo(
    kotlin_native,
    "com_github_jetbrains_kotlin_native_deps_linux_x86_64",
    "com_github_jetbrains_kotlin_native_deps_macos_aarch64",
    "com_github_jetbrains_kotlin_native_linux_x86_64",
    "com_github_jetbrains_kotlin_native_macos_aarch64",
)

# One per (exec host, konan target), see define_kt_native_toolchains.
register_toolchains(
    "//kotlin/internal/native:linux_x86_64_linux_arm64",
    "//kotlin/internal/native:linux_x86_64_linux_x64",
    "//kotlin/internal/native:macos_aarch64_ios_arm64",
    "//kotlin/internal/native:macos_aarch64_ios_simulator_arm64",
    "//kotlin/internal/native:macos_aarch64_linux_arm64",
    "//kotlin/internal/native:macos_aarch64_linux_x64",
    "//kotlin/internal/native:macos_aarch64_macos_arm64",
)
